# Go files use tabs, as gofmt writes them. Everything else uses spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
