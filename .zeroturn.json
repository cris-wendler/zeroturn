{
  "version": 1,
  "guard": {
    "mode": "confirm",
    "context": {
      "warn": 70,
      "confirm": 80,
      "critical": 90
    },
    "limits": {
      "fiveHourWarn": 75,
      "sevenDayWarn": 75,
      "projection": "on"
    },
    "session": {
      "durationWarnMinutes": 240,
      "activeSubagentsWarn": 2,
      "subagentStartsWarn": 4
    }
  },
  "verify": {
    "steps": [
      {
        "name": "vet",
        "command": [
          "go",
          "vet",
          "./..."
        ]
      },
      {
        "name": "test",
        "command": [
          "go",
          "test",
          "./..."
        ]
      }
    ]
  },
  "git": {
    "remote": "origin",
    "protectedBranches": [
      "main",
      "master"
    ]
  }
}
