{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cris-wendler/zeroturn/schemas/status.schema.json",
  "title": "ZeroTurn status",
  "description": "Output of zeroturn status --json. The session is present only when a recent record exists for this repository.",
  "type": "object",
  "required": [
    "sessionDataAvailable",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "sessionDataAvailable": {
      "type": "boolean"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "branch": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sessionId"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string"
        },
        "repoHash": {
          "type": "string",
          "description": "Identifies the repository without recording its path."
        },
        "harness": {
          "type": "string"
        },
        "harnessVersion": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer"
        },
        "contextPercent": {
          "type": "number"
        },
        "contextWindowSize": {
          "type": "integer"
        },
        "peakContextPercent": {
          "type": "number"
        },
        "fiveHourPercent": {
          "type": "number"
        },
        "fiveHourResetsAt": {
          "type": "integer"
        },
        "fiveHourBasePercent": {
          "type": "number",
          "description": "The first five hour reading seen in the window that is running now. The rate of use is measured from it."
        },
        "fiveHourBaseAt": {
          "type": "string",
          "description": "When that first reading was taken."
        },
        "fiveHourBaseReset": {
          "type": "integer",
          "description": "The reset time the baseline was taken under. A different fiveHourResetsAt means a new window and an unusable baseline."
        },
        "sevenDayPercent": {
          "type": "number"
        },
        "sevenDayResetsAt": {
          "type": "integer"
        },
        "subagentStarts": {
          "type": "integer"
        },
        "subagentStops": {
          "type": "integer"
        },
        "activeSubagents": {
          "type": "integer"
        },
        "peakActiveSubagents": {
          "type": "integer"
        },
        "backgroundTasks": {
          "type": "integer"
        },
        "confirmRequests": {
          "type": "integer"
        },
        "deniedSubagentStarts": {
          "type": "integer"
        },
        "allowedSubagentStarts": {
          "type": "integer"
        },
        "directValidations": {
          "type": "integer"
        },
        "directGitOperations": {
          "type": "integer"
        },
        "observedSteps": {
          "type": "integer",
          "description": "Validation steps seen to pass in a command the session ran. The command is compared with the configured steps in memory and is not stored."
        },
        "nearValidationRuns": {
          "type": "integer",
          "description": "Commands that were nearly a configured step and were not recorded, such as one package rather than every package. Reported so that a plan nothing matches can be told apart from the feature doing nothing."
        },
        "lastDecision": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "activeAgentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentialWarnings": {
          "type": "integer",
          "minimum": 0
        },
        "pendingAsk": {
          "type": "integer",
          "minimum": 0
        },
        "gateOutcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateOutcome"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "mode",
        "level",
        "decision",
        "triggers",
        "unmeasured"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "observe",
            "confirm",
            "strict"
          ]
        },
        "level": {
          "enum": [
            "ok",
            "warn",
            "confirm",
            "critical"
          ]
        },
        "decision": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "reason": {
          "type": "string"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unmeasured"
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "name",
        "observed",
        "limit",
        "level",
        "available"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "context",
            "fiveHour",
            "projection",
            "sevenDay",
            "duration",
            "activeSubagents",
            "subagentStarts",
            "backgroundTasks"
          ]
        },
        "observed": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "level": {
          "enum": [
            "warn",
            "confirm",
            "critical"
          ]
        },
        "text": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "gateOutcome": {
      "type": "object",
      "required": [
        "decision",
        "at",
        "approved"
      ],
      "additionalProperties": false,
      "description": "One gate decision and what followed it. Measurements and threshold names only.",
      "properties": {
        "decision": {
          "enum": [
            "ask",
            "deny"
          ]
        },
        "at": {
          "type": "string"
        },
        "approved": {
          "type": "boolean",
          "description": "Inferred: a subagent starting after an ask means it was approved."
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextPercent": {
          "type": "number"
        },
        "fiveHourPercent": {
          "type": "number"
        },
        "sevenDayPercent": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "activeSubagents": {
          "type": "integer"
        },
        "subagentStarts": {
          "type": "integer"
        }
      }
    },
    "unmeasured": {
      "type": "object",
      "required": [
        "name",
        "limit",
        "level",
        "available"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "context",
            "fiveHour",
            "sevenDay",
            "duration"
          ]
        },
        "limit": {
          "type": "number"
        },
        "level": {
          "const": "ok"
        },
        "text": {
          "type": "string"
        },
        "available": {
          "const": false
        }
      }
    }
  }
}
