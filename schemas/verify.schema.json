{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cris-wendler/zeroturn/schemas/verify.schema.json",
  "title": "ZeroTurn verify result",
  "description": "Output of zeroturn verify --json.",
  "type": "object",
  "required": [
    "steps",
    "passed",
    "failed",
    "skipped",
    "seconds",
    "cancelled"
  ],
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "cancelled": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object",
      "description": "The evidence record this run wrote, as described by evidence.schema.json. It names the repository state the result is evidence about, so a later command can say whether it still holds."
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "name",
        "command",
        "status",
        "exitCode",
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "missing",
            "cancelled"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "logFile": {
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "description": "Short tail of the output, with credentials replaced by their category."
        }
      }
    }
  }
}
